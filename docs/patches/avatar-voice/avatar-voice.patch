+            XCTAssertNil(session.retainedTranscript)
+        }
+    }
+
+    func testPermissionFailureUsesSafeEnglishAndNoUpload() async throws {
+        let recorder = VoiceRecorderStub(); recorder.startError = .permissionDenied
+        var uploaded = false
