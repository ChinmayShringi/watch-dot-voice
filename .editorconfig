root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{pbxproj,patch}]
trim_trailing_whitespace = false
insert_final_newline = false
