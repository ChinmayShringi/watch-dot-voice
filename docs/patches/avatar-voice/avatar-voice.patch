+        defer { try? handle.close() }
+        let data = try handle.read(upToCount: Self.maximumBytes + 1) ?? Data()
+        guard data.count == size.intValue, data.count <= Self.maximumBytes else {
+            throw VoiceInputIssue.invalidAudio
+        }
