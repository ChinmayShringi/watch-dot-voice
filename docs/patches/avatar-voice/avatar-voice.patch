+
+    private func persist() throws {
+        guard let scope else { return }
+        let manifest = Manifest(items: items.map { StoredItem(id: $0.id, name: $0.name, updatedAt: $0.updatedAt) },
+                                assets: assets, selectedID: selectedID)
